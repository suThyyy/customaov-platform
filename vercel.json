{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace base-frontend-web",
  "outputDirectory": "base-frontend-web/dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "dev": true,
      "main": true
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
