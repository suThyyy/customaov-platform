{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:shared": "npm run build --workspace @customaov/team-core && npm run build --workspace @customaov/contracts",
    "predev": "npm run build:shared",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:supabase": "vite --mode supabase",
    "prebuild": "npm run build:shared",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "screenshot": "node scripts/screenshot.mjs",
    "typecheck": "tsc -b",
    "pretest": "npm run build:shared",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-auth.mjs",
    "test:e2e:mock": "npm run test:e2e",
    "test:e2e:api": "node scripts/e2e-auth-api.mjs",
    "test:e2e:tournament": "node scripts/e2e-tournament-api.mjs",
    "test:e2e:rooms": "node scripts/e2e-rooms-api.mjs"
  },
  "dependencies": {
    "@customaov/contracts": "*",
    "@customaov/team-core": "file:../packages/team-core",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^1.73.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
